{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::dereknordgren-clawcasts"
    },
    {
      "Sid": "ReadWriteMediaAndFeeds",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::dereknordgren-clawcasts/*"
    },
    {
      "Sid": "DeleteRemovedEpisodes",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": "arn:aws:s3:::dereknordgren-clawcasts/*"
    },
    {
      "Sid": "InvalidateFeedCache",
      "Effect": "Allow",
      "Action": "cloudfront:CreateInvalidation",
      "Resource": "arn:aws:cloudfront::354450307824:distribution/E3SHNCWWKF8OI7"
    }
  ]
}
